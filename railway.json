{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "dockerfile": "Dockerfile"
  },
  "deploy": {
    "startCommand": "deno run --allow-all backend/src/main.ts",
    "restartPolicyCondition": "on-failure",
    "restartPolicyMaxRetries": 5
  },
  "environments": {
    "production": {
      "variables": {
        "PORT": "3000",
        "ENVIRONMENT": "production",
        "LOG_LEVEL": "info"
      }
    }
  }
}
